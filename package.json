{
  "name": "pixelutils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast, private browser-based tools with no account required.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:registry": "vitest run lib/catalog/registry.test.ts lib/seo/seo.test.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run validate:registry && npm run build"
  },
  "dependencies": {
    "he": "^1.2.0",
    "lucide-react": "^1.30.0",
    "marked": "^18.0.9",
    "next": "16.3.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/he": "^1.2.3",
    "@types/node": "26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
