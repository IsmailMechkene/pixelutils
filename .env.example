# Required in production for canonical URLs and sitemap entries.
SITE_URL=https://example.com

# Address used by the contact page's mailto link.
CONTACT_EMAIL=hello@example.com

# Analytics requires production mode, an explicit provider adapter, and both
# values below. No provider adapter is installed by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Advertising is server-configured and disabled by default. Do not enable it
# until a provider, consent policy, and verified slot identifiers are ready.
ADS_ENABLED=false
ADS_PROVIDER=
AD_SLOT_HOMEPAGE_CONTENT=
AD_SLOT_CATEGORY_CONTENT=
AD_SLOT_TOOL_AFTER_CONTENT=
AD_SLOT_SIDEBAR=
